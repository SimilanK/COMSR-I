(version 1)
# COMSR-I courtyard spacing, STRICT. Source: JLCPCB "minimum spacing for SMD components" pair table.
# https://jlcpcb.com/help/article/minimum-spacing-for-smd-components
# Pairs are mutually exclusive (rule order does not matter). Unassigned parts get only KiCad overlap check (gap >= 0).
# Classes:
#   P: chip <=0805
#   1206: chip 1206 (largest chip row): L1 4x4 inductor, D3 SMA diode
#   SOT: SOT: D1, U10, U11/U12 SOD-123
#   SOP/SOIC: none on board (U7 not present)
#   QFP: QFP: U1 MCU
#   QFN: QFN (bottom-terminated, no leads): U2 QFN, U3 MS5607 LGA, U9 LGA-14, Q1/Q2 PowerPAK 1212-8, X1/Y1 4-pad SMD oscillators
# Unassigned (no JLCPCB row): CN1, CN2, Card1, H1, H2, H3, H4, J1, J2, J3, J5, J6, J7, J8, SW1, SW2, SW3, SW4

(rule "jlc_P_P_0p18mm"
  (constraint courtyard_clearance (min 0.18mm))
  (condition "(A.Reference == 'R?' || A.Reference == 'R1?' || A.Reference == 'R2?' || A.Reference == 'R3?' || A.Reference == 'R4?' || A.Reference == 'C?' || A.Reference == 'C1?' || A.Reference == 'C2?' || A.Reference == 'C3?' || A.Reference == 'FB1' || A.Reference == 'JP1' || A.Reference == 'D4' || A.Reference == 'D5' || A.Reference == 'D6' || A.Reference == 'D7') && (B.Reference == 'R?' || B.Reference == 'R1?' || B.Reference == 'R2?' || B.Reference == 'R3?' || B.Reference == 'R4?' || B.Reference == 'C?' || B.Reference == 'C1?' || B.Reference == 'C2?' || B.Reference == 'C3?' || B.Reference == 'FB1' || B.Reference == 'JP1' || B.Reference == 'D4' || B.Reference == 'D5' || B.Reference == 'D6' || B.Reference == 'D7')"))

(rule "jlc_P_1206_0p25mm"
  (constraint courtyard_clearance (min 0.25mm))
  (condition "((A.Reference == 'R?' || A.Reference == 'R1?' || A.Reference == 'R2?' || A.Reference == 'R3?' || A.Reference == 'R4?' || A.Reference == 'C?' || A.Reference == 'C1?' || A.Reference == 'C2?' || A.Reference == 'C3?' || A.Reference == 'FB1' || A.Reference == 'JP1' || A.Reference == 'D4' || A.Reference == 'D5' || A.Reference == 'D6' || A.Reference == 'D7') && (B.Reference == 'L1' || B.Reference == 'D3')) || ((A.Reference == 'L1' || A.Reference == 'D3') && (B.Reference == 'R?' || B.Reference == 'R1?' || B.Reference == 'R2?' || B.Reference == 'R3?' || B.Reference == 'R4?' || B.Reference == 'C?' || B.Reference == 'C1?' || B.Reference == 'C2?' || B.Reference == 'C3?' || B.Reference == 'FB1' || B.Reference == 'JP1' || B.Reference == 'D4' || B.Reference == 'D5' || B.Reference == 'D6' || B.Reference == 'D7'))"))

(rule "jlc_1206_1206_0p35mm"
  (constraint courtyard_clearance (min 0.35mm))
  (condition "(A.Reference == 'L1' || A.Reference == 'D3') && (B.Reference == 'L1' || B.Reference == 'D3')"))

(rule "jlc_P_SOT_0p2mm"
  (constraint courtyard_clearance (min 0.2mm))
  (condition "((A.Reference == 'R?' || A.Reference == 'R1?' || A.Reference == 'R2?' || A.Reference == 'R3?' || A.Reference == 'R4?' || A.Reference == 'C?' || A.Reference == 'C1?' || A.Reference == 'C2?' || A.Reference == 'C3?' || A.Reference == 'FB1' || A.Reference == 'JP1' || A.Reference == 'D4' || A.Reference == 'D5' || A.Reference == 'D6' || A.Reference == 'D7') && (B.Reference == 'D1' || B.Reference == 'U10' || B.Reference == 'U11' || B.Reference == 'U12')) || ((A.Reference == 'D1' || A.Reference == 'U10' || A.Reference == 'U11' || A.Reference == 'U12') && (B.Reference == 'R?' || B.Reference == 'R1?' || B.Reference == 'R2?' || B.Reference == 'R3?' || B.Reference == 'R4?' || B.Reference == 'C?' || B.Reference == 'C1?' || B.Reference == 'C2?' || B.Reference == 'C3?' || B.Reference == 'FB1' || B.Reference == 'JP1' || B.Reference == 'D4' || B.Reference == 'D5' || B.Reference == 'D6' || B.Reference == 'D7'))"))

(rule "jlc_1206_SOT_0p2mm"
  (constraint courtyard_clearance (min 0.2mm))
  (condition "((A.Reference == 'L1' || A.Reference == 'D3') && (B.Reference == 'D1' || B.Reference == 'U10' || B.Reference == 'U11' || B.Reference == 'U12')) || ((A.Reference == 'D1' || A.Reference == 'U10' || A.Reference == 'U11' || A.Reference == 'U12') && (B.Reference == 'L1' || B.Reference == 'D3'))"))

(rule "jlc_P_QFP_0p5mm"
  (constraint courtyard_clearance (min 0.5mm))
  (condition "((A.Reference == 'R?' || A.Reference == 'R1?' || A.Reference == 'R2?' || A.Reference == 'R3?' || A.Reference == 'R4?' || A.Reference == 'C?' || A.Reference == 'C1?' || A.Reference == 'C2?' || A.Reference == 'C3?' || A.Reference == 'FB1' || A.Reference == 'JP1' || A.Reference == 'D4' || A.Reference == 'D5' || A.Reference == 'D6' || A.Reference == 'D7') && (B.Reference == 'U1')) || ((A.Reference == 'U1') && (B.Reference == 'R?' || B.Reference == 'R1?' || B.Reference == 'R2?' || B.Reference == 'R3?' || B.Reference == 'R4?' || B.Reference == 'C?' || B.Reference == 'C1?' || B.Reference == 'C2?' || B.Reference == 'C3?' || B.Reference == 'FB1' || B.Reference == 'JP1' || B.Reference == 'D4' || B.Reference == 'D5' || B.Reference == 'D6' || B.Reference == 'D7'))"))

(rule "jlc_1206_QFP_0p5mm"
  (constraint courtyard_clearance (min 0.5mm))
  (condition "((A.Reference == 'L1' || A.Reference == 'D3') && (B.Reference == 'U1')) || ((A.Reference == 'U1') && (B.Reference == 'L1' || B.Reference == 'D3'))"))

(rule "jlc_P_QFN_1p0mm"
  (constraint courtyard_clearance (min 1.0mm))
  (condition "((A.Reference == 'R?' || A.Reference == 'R1?' || A.Reference == 'R2?' || A.Reference == 'R3?' || A.Reference == 'R4?' || A.Reference == 'C?' || A.Reference == 'C1?' || A.Reference == 'C2?' || A.Reference == 'C3?' || A.Reference == 'FB1' || A.Reference == 'JP1' || A.Reference == 'D4' || A.Reference == 'D5' || A.Reference == 'D6' || A.Reference == 'D7') && (B.Reference == 'U2' || B.Reference == 'U3' || B.Reference == 'U9' || B.Reference == 'Q1' || B.Reference == 'Q2' || B.Reference == 'X1' || B.Reference == 'Y1')) || ((A.Reference == 'U2' || A.Reference == 'U3' || A.Reference == 'U9' || A.Reference == 'Q1' || A.Reference == 'Q2' || A.Reference == 'X1' || A.Reference == 'Y1') && (B.Reference == 'R?' || B.Reference == 'R1?' || B.Reference == 'R2?' || B.Reference == 'R3?' || B.Reference == 'R4?' || B.Reference == 'C?' || B.Reference == 'C1?' || B.Reference == 'C2?' || B.Reference == 'C3?' || B.Reference == 'FB1' || B.Reference == 'JP1' || B.Reference == 'D4' || B.Reference == 'D5' || B.Reference == 'D6' || B.Reference == 'D7'))"))

(rule "jlc_1206_QFN_1p0mm"
  (constraint courtyard_clearance (min 1.0mm))
  (condition "((A.Reference == 'L1' || A.Reference == 'D3') && (B.Reference == 'U2' || B.Reference == 'U3' || B.Reference == 'U9' || B.Reference == 'Q1' || B.Reference == 'Q2' || B.Reference == 'X1' || B.Reference == 'Y1')) || ((A.Reference == 'U2' || A.Reference == 'U3' || A.Reference == 'U9' || A.Reference == 'Q1' || A.Reference == 'Q2' || A.Reference == 'X1' || A.Reference == 'Y1') && (B.Reference == 'L1' || B.Reference == 'D3'))"))

(rule "jlc_SOT_SOT_0p4mm"
  (constraint courtyard_clearance (min 0.4mm))
  (condition "(A.Reference == 'D1' || A.Reference == 'U10' || A.Reference == 'U11' || A.Reference == 'U12') && (B.Reference == 'D1' || B.Reference == 'U10' || B.Reference == 'U11' || B.Reference == 'U12')"))

(rule "jlc_SOT_QFP_1p0mm"
  (constraint courtyard_clearance (min 1.0mm))
  (condition "((A.Reference == 'D1' || A.Reference == 'U10' || A.Reference == 'U11' || A.Reference == 'U12') && (B.Reference == 'U1')) || ((A.Reference == 'U1') && (B.Reference == 'D1' || B.Reference == 'U10' || B.Reference == 'U11' || B.Reference == 'U12'))"))

(rule "jlc_SOT_QFN_1p0mm"
  (constraint courtyard_clearance (min 1.0mm))
  (condition "((A.Reference == 'D1' || A.Reference == 'U10' || A.Reference == 'U11' || A.Reference == 'U12') && (B.Reference == 'U2' || B.Reference == 'U3' || B.Reference == 'U9' || B.Reference == 'Q1' || B.Reference == 'Q2' || B.Reference == 'X1' || B.Reference == 'Y1')) || ((A.Reference == 'U2' || A.Reference == 'U3' || A.Reference == 'U9' || A.Reference == 'Q1' || A.Reference == 'Q2' || A.Reference == 'X1' || A.Reference == 'Y1') && (B.Reference == 'D1' || B.Reference == 'U10' || B.Reference == 'U11' || B.Reference == 'U12'))"))

(rule "jlc_QFP_QFN_1p0mm"
  (constraint courtyard_clearance (min 1.0mm))
  (condition "((A.Reference == 'U1') && (B.Reference == 'U2' || B.Reference == 'U3' || B.Reference == 'U9' || B.Reference == 'Q1' || B.Reference == 'Q2' || B.Reference == 'X1' || B.Reference == 'Y1')) || ((A.Reference == 'U2' || A.Reference == 'U3' || A.Reference == 'U9' || A.Reference == 'Q1' || A.Reference == 'Q2' || A.Reference == 'X1' || A.Reference == 'Y1') && (B.Reference == 'U1'))"))

(rule "jlc_QFN_QFN_1p0mm"
  (constraint courtyard_clearance (min 1.0mm))
  (condition "(A.Reference == 'U2' || A.Reference == 'U3' || A.Reference == 'U9' || A.Reference == 'Q1' || A.Reference == 'Q2' || A.Reference == 'X1' || A.Reference == 'Y1') && (B.Reference == 'U2' || B.Reference == 'U3' || B.Reference == 'U9' || B.Reference == 'Q1' || B.Reference == 'Q2' || B.Reference == 'X1' || B.Reference == 'Y1')"))
