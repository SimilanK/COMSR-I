(version 1)
# COMSR-I courtyard spacing, bare minimum from the JLCPCB table:
# https://jlcpcb.com/help/article/minimum-spacing-for-smd-components
# JLC = part-to-part distance. KiCad checks courtyard-to-courtyard, so:
# courtyard gap = JLC - margin(A) - margin(B), rounded up to 0.05 mm.
# Margins measured on this board: P 0.08 | 1206 0.25 | SOT 0.245 | QFP 0.255 | QFN 0.15 | PPAK -0.05
# Classes: P = R/C/FB1/JP1/D4-D7 | 1206 = L1, D3 | SOT = D1, U10, U11, U12 | QFP = U1
#          QFN = U2, U3, U9, X1, Y1 | PPAK = Q1, Q2 (courtyard sits inside its pads)
# No rule (overlap check only): P-1206, P-SOT, 1206-1206, 1206-SOT, 1206-QFP, SOT-SOT

(rule "jlc_P_P_0p05mm"
  (constraint courtyard_clearance (min 0.05mm))
  (condition "(A.Reference == 'R?' || A.Reference == 'R1?' || A.Reference == 'R2?' || A.Reference == 'R3?' || A.Reference == 'R4?' || A.Reference == 'C?' || A.Reference == 'C1?' || A.Reference == 'C2?' || A.Reference == 'C3?' || A.Reference == 'FB1' || A.Reference == 'JP1' || A.Reference == 'D4' || A.Reference == 'D5' || A.Reference == 'D6' || A.Reference == 'D7') && (B.Reference == 'R?' || B.Reference == 'R1?' || B.Reference == 'R2?' || B.Reference == 'R3?' || B.Reference == 'R4?' || B.Reference == 'C?' || B.Reference == 'C1?' || B.Reference == 'C2?' || B.Reference == 'C3?' || B.Reference == 'FB1' || B.Reference == 'JP1' || B.Reference == 'D4' || B.Reference == 'D5' || B.Reference == 'D6' || B.Reference == 'D7')"))

(rule "jlc_P_QFP_0p2mm"
  (constraint courtyard_clearance (min 0.2mm))
  (condition "((A.Reference == 'R?' || A.Reference == 'R1?' || A.Reference == 'R2?' || A.Reference == 'R3?' || A.Reference == 'R4?' || A.Reference == 'C?' || A.Reference == 'C1?' || A.Reference == 'C2?' || A.Reference == 'C3?' || A.Reference == 'FB1' || A.Reference == 'JP1' || A.Reference == 'D4' || A.Reference == 'D5' || A.Reference == 'D6' || A.Reference == 'D7') && (B.Reference == 'U1')) || ((A.Reference == 'U1') && (B.Reference == 'R?' || B.Reference == 'R1?' || B.Reference == 'R2?' || B.Reference == 'R3?' || B.Reference == 'R4?' || B.Reference == 'C?' || B.Reference == 'C1?' || B.Reference == 'C2?' || B.Reference == 'C3?' || B.Reference == 'FB1' || B.Reference == 'JP1' || B.Reference == 'D4' || B.Reference == 'D5' || B.Reference == 'D6' || B.Reference == 'D7'))"))

(rule "jlc_P_QFN_0p8mm"
  (constraint courtyard_clearance (min 0.8mm))
  (condition "((A.Reference == 'R?' || A.Reference == 'R1?' || A.Reference == 'R2?' || A.Reference == 'R3?' || A.Reference == 'R4?' || A.Reference == 'C?' || A.Reference == 'C1?' || A.Reference == 'C2?' || A.Reference == 'C3?' || A.Reference == 'FB1' || A.Reference == 'JP1' || A.Reference == 'D4' || A.Reference == 'D5' || A.Reference == 'D6' || A.Reference == 'D7') && (B.Reference == 'U2' || B.Reference == 'U3' || B.Reference == 'U9' || B.Reference == 'X1' || B.Reference == 'Y1')) || ((A.Reference == 'U2' || A.Reference == 'U3' || A.Reference == 'U9' || A.Reference == 'X1' || A.Reference == 'Y1') && (B.Reference == 'R?' || B.Reference == 'R1?' || B.Reference == 'R2?' || B.Reference == 'R3?' || B.Reference == 'R4?' || B.Reference == 'C?' || B.Reference == 'C1?' || B.Reference == 'C2?' || B.Reference == 'C3?' || B.Reference == 'FB1' || B.Reference == 'JP1' || B.Reference == 'D4' || B.Reference == 'D5' || B.Reference == 'D6' || B.Reference == 'D7'))"))

(rule "jlc_P_PPAK_1p0mm"
  (constraint courtyard_clearance (min 1.0mm))
  (condition "((A.Reference == 'R?' || A.Reference == 'R1?' || A.Reference == 'R2?' || A.Reference == 'R3?' || A.Reference == 'R4?' || A.Reference == 'C?' || A.Reference == 'C1?' || A.Reference == 'C2?' || A.Reference == 'C3?' || A.Reference == 'FB1' || A.Reference == 'JP1' || A.Reference == 'D4' || A.Reference == 'D5' || A.Reference == 'D6' || A.Reference == 'D7') && (B.Reference == 'Q1' || B.Reference == 'Q2')) || ((A.Reference == 'Q1' || A.Reference == 'Q2') && (B.Reference == 'R?' || B.Reference == 'R1?' || B.Reference == 'R2?' || B.Reference == 'R3?' || B.Reference == 'R4?' || B.Reference == 'C?' || B.Reference == 'C1?' || B.Reference == 'C2?' || B.Reference == 'C3?' || B.Reference == 'FB1' || B.Reference == 'JP1' || B.Reference == 'D4' || B.Reference == 'D5' || B.Reference == 'D6' || B.Reference == 'D7'))"))

(rule "jlc_1206_QFN_0p6mm"
  (constraint courtyard_clearance (min 0.6mm))
  (condition "((A.Reference == 'L1' || A.Reference == 'D3') && (B.Reference == 'U2' || B.Reference == 'U3' || B.Reference == 'U9' || B.Reference == 'X1' || B.Reference == 'Y1')) || ((A.Reference == 'U2' || A.Reference == 'U3' || A.Reference == 'U9' || A.Reference == 'X1' || A.Reference == 'Y1') && (B.Reference == 'L1' || B.Reference == 'D3'))"))

(rule "jlc_1206_PPAK_0p8mm"
  (constraint courtyard_clearance (min 0.8mm))
  (condition "((A.Reference == 'L1' || A.Reference == 'D3') && (B.Reference == 'Q1' || B.Reference == 'Q2')) || ((A.Reference == 'Q1' || A.Reference == 'Q2') && (B.Reference == 'L1' || B.Reference == 'D3'))"))

(rule "jlc_SOT_QFP_0p5mm"
  (constraint courtyard_clearance (min 0.5mm))
  (condition "((A.Reference == 'D1' || A.Reference == 'U10' || A.Reference == 'U11' || A.Reference == 'U12') && (B.Reference == 'U1')) || ((A.Reference == 'U1') && (B.Reference == 'D1' || B.Reference == 'U10' || B.Reference == 'U11' || B.Reference == 'U12'))"))

(rule "jlc_SOT_QFN_0p65mm"
  (constraint courtyard_clearance (min 0.65mm))
  (condition "((A.Reference == 'D1' || A.Reference == 'U10' || A.Reference == 'U11' || A.Reference == 'U12') && (B.Reference == 'U2' || B.Reference == 'U3' || B.Reference == 'U9' || B.Reference == 'X1' || B.Reference == 'Y1')) || ((A.Reference == 'U2' || A.Reference == 'U3' || A.Reference == 'U9' || A.Reference == 'X1' || A.Reference == 'Y1') && (B.Reference == 'D1' || B.Reference == 'U10' || B.Reference == 'U11' || B.Reference == 'U12'))"))

(rule "jlc_SOT_PPAK_0p85mm"
  (constraint courtyard_clearance (min 0.85mm))
  (condition "((A.Reference == 'D1' || A.Reference == 'U10' || A.Reference == 'U11' || A.Reference == 'U12') && (B.Reference == 'Q1' || B.Reference == 'Q2')) || ((A.Reference == 'Q1' || A.Reference == 'Q2') && (B.Reference == 'D1' || B.Reference == 'U10' || B.Reference == 'U11' || B.Reference == 'U12'))"))

(rule "jlc_QFP_QFN_0p6mm"
  (constraint courtyard_clearance (min 0.6mm))
  (condition "((A.Reference == 'U1') && (B.Reference == 'U2' || B.Reference == 'U3' || B.Reference == 'U9' || B.Reference == 'X1' || B.Reference == 'Y1')) || ((A.Reference == 'U2' || A.Reference == 'U3' || A.Reference == 'U9' || A.Reference == 'X1' || A.Reference == 'Y1') && (B.Reference == 'U1'))"))

(rule "jlc_QFP_PPAK_0p8mm"
  (constraint courtyard_clearance (min 0.8mm))
  (condition "((A.Reference == 'U1') && (B.Reference == 'Q1' || B.Reference == 'Q2')) || ((A.Reference == 'Q1' || A.Reference == 'Q2') && (B.Reference == 'U1'))"))

(rule "jlc_QFN_QFN_0p7mm"
  (constraint courtyard_clearance (min 0.7mm))
  (condition "(A.Reference == 'U2' || A.Reference == 'U3' || A.Reference == 'U9' || A.Reference == 'X1' || A.Reference == 'Y1') && (B.Reference == 'U2' || B.Reference == 'U3' || B.Reference == 'U9' || B.Reference == 'X1' || B.Reference == 'Y1')"))

(rule "jlc_QFN_PPAK_0p9mm"
  (constraint courtyard_clearance (min 0.9mm))
  (condition "((A.Reference == 'U2' || A.Reference == 'U3' || A.Reference == 'U9' || A.Reference == 'X1' || A.Reference == 'Y1') && (B.Reference == 'Q1' || B.Reference == 'Q2')) || ((A.Reference == 'Q1' || A.Reference == 'Q2') && (B.Reference == 'U2' || B.Reference == 'U3' || B.Reference == 'U9' || B.Reference == 'X1' || B.Reference == 'Y1'))"))

(rule "jlc_PPAK_PPAK_1p1mm"
  (constraint courtyard_clearance (min 1.1mm))
  (condition "(A.Reference == 'Q1' || A.Reference == 'Q2') && (B.Reference == 'Q1' || B.Reference == 'Q2')"))